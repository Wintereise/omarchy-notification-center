#!/usr/bin/env bash
#
# Archive behind the jgarza.notification panel.
#
# Omarchy's notification service (4.5+) keeps two files under
# ~/.local/state/omarchy/notifications/: live.json (cards on screen, oldest
# first) and history.json (closed cards, newest first, at most 100 and 24
# hours). Both are rewritten whole, atomically. This copies every row into an
# archive kept for NS_KEEP_DAYS / NS_MAX_ITEMS. It only ever reads the
# service's files.
#
# Rows arrive already sanitised by Omarchy: secret-bearing notifications
# (one-time codes) are stored as "Verification notification" / "[redacted]",
# and images never persist, so neither does the archive.
#
# Subcommands (all print JSON):
#   watch          sync, then print each newly archived entry as a JSON line,
#                  and {"changed":true} whenever the archive or seen mark
#                  changes (another bar instance, a remove, a clear)
#   sync           archive anything not archived yet
#   list [N]       newest-first array of up to N entries (default 500)
#   remove KEY...  drop entries
#   clear          drop everything, and Omarchy's own history too
#   prune          apply the retention limits
#   live           keys of toasts still on screen, newest first
#   seen [MS]      read / set the last-opened timestamp (for the unread badge)
#   seed [N]       add N fake entries (testing)

set -uo pipefail
umask 077

state_home=${XDG_STATE_HOME:-$HOME/.local/state}
src_dir=${NS_SRC_DIR:-$state_home/omarchy/notifications}
src_live=$src_dir/live.json
src_history=$src_dir/history.json
store=${NS_STORE:-$state_home/jgarza-notification}
archive=$store/archive.jsonl
seen_file=$store/seen
# Keys removed by hand. Their row may still sit in Omarchy's live.json or
# history.json, and without this the next sync would archive it all over again.
removed_file=$store/removed
lock_file=$store/lock

keep_days=${NS_KEEP_DAYS:-30}
max_items=${NS_MAX_ITEMS:-500}
[[ $keep_days =~ ^[0-9]+$ ]] || keep_days=30
[[ $max_items =~ ^[0-9]+$ ]] || max_items=500

json_str() { printf '%s' "$1" | jq -Rs .; }

die() {
  printf '{"ok":false,"error":%s}\n' "$(json_str "$1")"
  exit 1
}

command -v jq >/dev/null 2>&1 || { printf '{"ok":false,"error":"jq is not installed"}\n'; exit 1; }

ensure_store() {
  mkdir -p "$store" || die "cannot create $store"
  [[ -f $archive ]] || : > "$archive"
  chmod 700 "$store" 2>/dev/null || true
}

with_lock() { ( exec 9>"$lock_file"; flock 9; "$@" ); }

now_ms() { printf '%s' "$(($(date +%s%N) / 1000000))"; }

was_removed() { grep -qxF "$1" "$removed_file" 2>/dev/null; }

# Omarchy caps each file near 100 rows of 16 KB; anything far bigger is not
# its file, so it is not parsed.
readable() { [[ -f $1 && -s $1 ]] && (( $(stat -c%s -- "$1" 2>/dev/null || echo 0) <= 8388608 )); }

# Keys of every row Omarchy still holds, one per line.
source_keys() {
  local f
  for f in "$src_live" "$src_history"; do
    readable "$f" && jq -r 'if type == "array" then .[] | objects | .key | strings else empty end' "$f" 2>/dev/null
  done
  return 0
}

# Archive every row not archived or removed yet; prints the new entries.
# Keyed by Omarchy's own row key, which stays the same when a card moves from
# live.json into history.json, so each notification is archived once.
sync_all() {
  local known f
  known=$( { jq -r '.key // empty' "$archive" 2>/dev/null; cat "$removed_file" 2>/dev/null; } )
  for f in "$src_live" "$src_history"; do
    readable "$f" || continue
    jq -c --arg known "$known" '
      ($known | split("\n") | map(select(. != "") | {(.): true}) | add // {}) as $seen
      | if type == "array" then .[] else empty end | objects
      | select((.key | type) == "string" and (.key | test("^[A-Za-z0-9_-]{1,120}$")))
      | select($seen[.key] | not)
      | ((.ts | if type == "number" then . else (tonumber? // 0) end) * 1000 | floor) as $t
      | select($t > 0)
      | {
          key: .key,
          id: (.originalId // 0),
          originalId: (.originalId // 0),
          app: (.app // "" | tostring),
          appIcon: (.appIcon // "" | tostring),
          summary: (.summary // "" | tostring),
          body: (.body // "" | tostring),
          image: "",
          # A screenshot/camera card'"'"'s action points at the picture. Keep that
          # path (never the command itself) so Enter can open it later.
          file: ([.execArgv // "" | (if type == "string" then (fromjson? // []) else . end)
                  | if type == "array" then .[] else empty end | strings
                  | select(test("^/.*\\.(png|jpe?g|webp|gif)$"; "i"))] | first // ""),
          glyph: (.glyph // "" | tostring),
          urgency: (.urgency | if type == "number" then . else (tonumber? // 1) end),
          timestamp: $t
        }' "$f" 2>/dev/null
  done | while IFS= read -r entry; do
    # live.json and history.json can both hold a key mid-move.
    key=$(jq -r .key <<< "$entry")
    grep -qF "\"key\":\"$key\"" "$archive" && continue
    printf '%s\n' "$entry" >> "$archive"
    printf '%s\n' "$entry"
  done
  return 0
}

prune() {
  local cutoff kept
  # Tombstones only matter while Omarchy still holds the row.
  if [[ -s $removed_file ]]; then
    grep -xFf <(source_keys) "$removed_file" > "$removed_file.tmp" || : > "$removed_file.tmp"
    mv -f "$removed_file.tmp" "$removed_file"
  fi
  [[ -s $archive ]] || return 0
  cutoff=$(( $(now_ms) - keep_days * 86400000 ))
  # Archive order is arrival order; sort by time so the limit keeps the newest.
  # Read line by line so one damaged line is dropped, not everything after it.
  kept=$(jq -ncR --argjson cutoff "$cutoff" '[inputs | fromjson? | objects
           | select((.timestamp | type) == "number" and .timestamp >= $cutoff)]
         | sort_by(.timestamp) | .[]' "$archive" 2>/dev/null | tail -n "$max_items")
  printf '%s\n' "$kept" | grep -v '^$' > "$archive.tmp" || : > "$archive.tmp"
  mv -f "$archive.tmp" "$archive"
}

cmd_sync() {
  ensure_store
  with_lock sync_all
  with_lock prune
}

cmd_watch() {
  ensure_store
  cmd_sync
  command -v inotifywait >/dev/null 2>&1 || die "inotifywait is not installed"
  # Omarchy replaces its files by atomic rename (moved_to); close_write covers
  # an in-place write.
  exec 3< <(inotifywait -m -q -e close_write -e moved_to --format '%w%f' \
             "$src_dir" "$store" 2>/dev/null)
  watcher=$!
  trap 'kill "$watcher" 2>/dev/null' EXIT INT TERM
  local file
  while IFS= read -r file <&3; do
    # Our own store: tell the panel to reload, so every bar instance (one per
    # monitor) sees what any of them archived, removed, cleared or read.
    case $file in
      "$archive" | "$seen_file") printf '{"changed":true}\n'; continue ;;
      "$src_live" | "$src_history") ;;
      *) continue ;;
    esac
    with_lock sync_all
    with_lock prune
  done
}

cmd_list() {
  ensure_store
  local limit=${1:-500}
  [[ $limit =~ ^[0-9]+$ ]] || limit=500
  jq -ncR --argjson n "$limit" '[inputs | fromjson? | objects | select((.timestamp | type) == "number")]
    | sort_by(-.timestamp) | .[:$n]' "$archive" 2>/dev/null || printf '[]\n'
}

remove_key() {
  grep -vF "\"key\":\"$1\"" "$archive" > "$archive.tmp" || : > "$archive.tmp"
  mv -f "$archive.tmp" "$archive"
  was_removed "$1" || printf '%s\n' "$1" >> "$removed_file"
}

cmd_remove() {
  local key
  ensure_store
  (( $# > 0 )) || die "remove needs a key"
  for key; do [[ $key =~ ^[A-Za-z0-9_-]{1,120}$ ]] || die "remove needs a key"; done
  for key; do with_lock remove_key "$key"; done
  printf '{"ok":true,"removed":%s}\n' "$(json_str "$*")"
}

clear_all() {
  # Omarchy has no call to clear its own history, so tombstone everything it
  # still holds; otherwise the next sync would bring it straight back.
  source_keys > "$removed_file"
  : > "$archive"
}

cmd_clear() {
  ensure_store
  with_lock clear_all
  # Take the cards off the screen too.
  if [[ -z ${NS_SRC_DIR:-} ]] && command -v omarchy-shell >/dev/null 2>&1; then
    omarchy-shell notifications dismissAll >/dev/null 2>&1 || true
  fi
  printf '{"ok":true,"cleared":true}\n'
}

# Keys of cards still on screen, newest first.
cmd_live() {
  readable "$src_live" || { printf '[]\n'; return; }
  jq -c 'if type == "array" then [.[] | objects
           | select((.key | type) == "string" and (.key | test("^[A-Za-z0-9_-]{1,120}$")))]
           | sort_by(-(.ts | if type == "number" then . else (tonumber? // 0) end)) | map(.key)
         else [] end' "$src_live" 2>/dev/null || printf '[]\n'
}

cmd_seen() {
  ensure_store
  if [[ ${1:-} =~ ^[0-9]+$ ]]; then
    printf '%s\n' "$1" > "$seen_file"
  fi
  printf '{"ok":true,"seen":%s}\n' "$(cat "$seen_file" 2>/dev/null || echo 0)"
}

seed_entries() {
  local n=$1 i now apps summaries
  now=$(now_ms)
  apps=(Slack Signal Spotify Chromium Discord omarchy Thunderbird com.mitchellh.ghostty)
  summaries=("New message" "Build finished" "Now playing" "Calendar: standup in 10 minutes"
             "Pull request approved" "Update available" "Invoice paid" "Claude is waiting for your input")
  for (( i = 0; i < n; i++ )); do
    local ts=$(( now - i * 47 * 60000 )) k=$(( i % ${#apps[@]} ))
    jq -cn --arg key "$ts-$((900000 + i))" --arg app "${apps[$k]}" --arg s "${summaries[$k]}" \
      --arg b "Sample notification $((i + 1)) for testing the panel" --argjson ts "$ts" --argjson u "$(( i == 3 ? 2 : 1 ))" \
      '{key: $key, id: 0, originalId: 0, app: $app, appIcon: "", summary: $s, body: $b,
        image: "", file: "", glyph: "", urgency: $u, timestamp: $ts}' >> "$archive"
  done
}

cmd_seed() {
  ensure_store
  local n=${1:-20}
  [[ $n =~ ^[0-9]+$ ]] || n=20
  with_lock seed_entries "$n"
  printf '{"ok":true,"seeded":%s}\n' "$n"
}

case ${1:-} in
  watch) cmd_watch ;;
  sync) cmd_sync >/dev/null; printf '{"ok":true}\n' ;;
  list) cmd_list "${2:-500}" ;;
  remove) shift; cmd_remove "$@" ;;
  clear) cmd_clear ;;
  prune) ensure_store; with_lock prune; printf '{"ok":true}\n' ;;
  live) cmd_live ;;
  seen) cmd_seen "${2:-}" ;;
  seed) cmd_seed "${2:-20}" ;;
  *) die "usage: notification-store watch|sync|list [N]|remove KEY...|clear|prune|live|seen [MS]|seed [N]" ;;
esac
